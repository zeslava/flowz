#!/bin/sh

# PROVIDE: flowz_agent
# REQUIRE: NETWORKING flowz_server
# KEYWORD: shutdown

. /etc/rc.subr

name="flowz_agent"
rcvar="flowz_agent_enable"

load_rc_config $name

: ${flowz_agent_enable:="NO"}
: ${flowz_agent_user:="flowz"}
: ${flowz_agent_config:="/usr/local/etc/flowz/agent.yaml"}
: ${flowz_agent_log:="/var/log/flowz/agent.log"}
: ${flowz_agent_workspace:="/var/db/flowz/work"}

pidfile="/var/run/flowz/agent.pid"
command="/usr/local/bin/flowz"
command_args="agent"
command_interpreter=""

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

flowz_agent_prestart()
{
    if [ ! -f "${flowz_agent_config}" ]; then
        echo "${flowz_agent_config} not found"
        return 1
    fi
    install -d -o ${flowz_agent_user} -g ${flowz_agent_user} /var/run/flowz
    install -d -o ${flowz_agent_user} -g ${flowz_agent_user} $(dirname ${flowz_agent_log})
    install -d -o ${flowz_agent_user} -g ${flowz_agent_user} ${flowz_agent_workspace}
    touch ${flowz_agent_log}
    chown ${flowz_agent_user} ${flowz_agent_log}
}

flowz_agent_start()
{
    flowz_agent_prestart || return 1
    echo "Starting ${name}."
    # daemon -f (no -r) forks the process and writes its PID to -P pidfile;
    # su -m -c "exec ..." replaces itself with flowz, so pidfile == flowz PID.
    /usr/sbin/daemon -f -P ${pidfile} -o ${flowz_agent_log} \
        /usr/bin/su -m ${flowz_agent_user} -c \
        "export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin; export FLOWZ_AGENT_CONFIG=${flowz_agent_config}; exec ${command} ${command_args}"
}

flowz_agent_match="${command} ${command_args}"

flowz_agent_stop()
{
    if pgrep -f "${flowz_agent_match}" >/dev/null 2>&1; then
        echo "Stopping ${name}."
        # su forks under PAM, so the pidfile is unreliable; signal flowz (and
        # its daemon/su wrappers) by command line. Graceful TERM, then KILL.
        pkill -TERM -f "${flowz_agent_match}" 2>/dev/null
        _n=0
        while pgrep -f "${flowz_agent_match}" >/dev/null 2>&1; do
            _n=$((_n + 1))
            [ ${_n} -eq 20 ] && pkill -KILL -f "${flowz_agent_match}" 2>/dev/null
            [ ${_n} -ge 40 ] && break
            sleep 0.5
        done
    else
        echo "${name} is not running."
    fi
    rm -f ${pidfile}
}

flowz_agent_status()
{
    _pids=$(pgrep -f "${flowz_agent_match}")
    if [ -n "${_pids}" ]; then
        echo "${name} is running as pid ${_pids}."
    else
        echo "${name} is not running."
        return 1
    fi
}

run_rc_command "$1"
