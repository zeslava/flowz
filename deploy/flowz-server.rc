#!/bin/sh

# PROVIDE: flowz_server
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="flowz_server"
rcvar="flowz_server_enable"

load_rc_config $name

: ${flowz_server_enable:="NO"}
: ${flowz_server_user:="flowz"}
: ${flowz_server_config:="/usr/local/etc/flowz/server.yaml"}
: ${flowz_server_log:="/var/log/flowz/server.log"}

pidfile="/var/run/flowz/server.pid"
command="/usr/local/bin/flowz"
command_args="server"
command_interpreter=""

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

flowz_server_prestart()
{
    if [ ! -f "${flowz_server_config}" ]; then
        echo "${flowz_server_config} not found"
        return 1
    fi
    mkdir -p /var/run/flowz
    chown ${flowz_server_user} /var/run/flowz
    touch ${flowz_server_log}
    chown ${flowz_server_user} ${flowz_server_log}
}

flowz_server_start()
{
    flowz_server_prestart || return 1
    echo "Starting ${name}."
    /usr/sbin/daemon -f -P ${pidfile} -o ${flowz_server_log} \
        /usr/bin/su -m ${flowz_server_user} -c \
        "export FLOWZ_CONFIG=${flowz_server_config}; exec ${command} ${command_args}"
}

flowz_server_stop()
{
    if [ -f "${pidfile}" ]; then
        echo "Stopping ${name}."
        kill $(cat ${pidfile}) 2>/dev/null
        rm -f ${pidfile}
    else
        echo "${name} is not running."
    fi
}

flowz_server_status()
{
    if [ -f "${pidfile}" ] && kill -0 $(cat ${pidfile}) 2>/dev/null; then
        echo "${name} is running as pid $(cat ${pidfile})."
    else
        echo "${name} is not running."
        return 1
    fi
}

run_rc_command "$1"
