#!/bin/sh

# PROVIDE: flowz_server
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="flowz_server"
rcvar="flowz_server_enable"

load_rc_config $name

: ${flowz_server_enable:="NO"}
: ${flowz_server_user:="flowz"}
: ${flowz_server_config:="/usr/local/etc/flowz/server.yaml"}
: ${flowz_server_log:="/var/log/flowz/server.log"}

pidfile="/var/run/flowz/server.pid"          # supervising daemon(8) PID
childpidfile="/var/run/flowz/server.child.pid" # actual flowz PID
command="/usr/local/bin/flowz"
command_args="server"
command_interpreter=""

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

flowz_server_prestart()
{
    if [ ! -f "${flowz_server_config}" ]; then
        echo "${flowz_server_config} not found"
        return 1
    fi
    install -d -o ${flowz_server_user} -g ${flowz_server_user} /var/run/flowz
    install -d -o ${flowz_server_user} -g ${flowz_server_user} $(dirname ${flowz_server_log})
    touch ${flowz_server_log}
    chown ${flowz_server_user} ${flowz_server_log}
}

flowz_server_start()
{
    flowz_server_prestart || return 1
    echo "Starting ${name}."
    # daemon -f starts its own session; -P records the supervisor PID (== the
    # process-group leader), -p records the flowz PID. su may fork under PAM,
    # so stop kills the whole process group to never leave an orphan.
    /usr/sbin/daemon -f -P ${pidfile} -p ${childpidfile} -o ${flowz_server_log} \
        /usr/bin/su -m ${flowz_server_user} -c \
        "export FLOWZ_CONFIG=${flowz_server_config}; exec ${command} ${command_args}"
}

flowz_server_stop()
{
    if [ -f "${pidfile}" ] && kill -0 $(cat ${pidfile}) 2>/dev/null; then
        echo "Stopping ${name}."
        # negative PID == signal the entire process group (daemon + su + flowz)
        kill -TERM -- -$(cat ${pidfile}) 2>/dev/null
        wait_for_pids $(cat ${pidfile}) $(cat ${childpidfile} 2>/dev/null)
    else
        echo "${name} is not running."
    fi
    rm -f ${pidfile} ${childpidfile}
}

flowz_server_status()
{
    if [ -f "${childpidfile}" ] && kill -0 $(cat ${childpidfile}) 2>/dev/null; then
        echo "${name} is running as pid $(cat ${childpidfile})."
    else
        echo "${name} is not running."
        return 1
    fi
}

run_rc_command "$1"
